PORT=3000
NODE_ENV=development

# MongoDB Atlas konekcija bez čuvanja stvarne lozinke u repozitorijumu.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=veb_agencija
MONGODB_SOURCE_DB=test

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=OVDE_IDE_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=OVDE_IDE_PAYPAL_CLIENT_SECRET
